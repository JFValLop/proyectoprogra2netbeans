<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="768" prefWidth="1366"
            styleClass="app"
            stylesheets="@../com/umg/api/ui/styles.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.umg.api.controller.Artistas_Controller">


    <center>
        <VBox>
            <children>
                <!-- ENCABEZADO -->
                <HBox alignment="BOTTOM_LEFT" spacing="10">
                    <padding>
                        <Insets bottom="16" left="28" right="28" top="22"/>
                    </padding>

                    <children>
                        <VBox spacing="6">
                            <children>
                                <Label fx:id="lblSeccion"
                                       styleClass="eyebrow"
                                       text="CATÁLOGO · ARTISTAS"/>

                                <Label fx:id="lblTitulo"
                                       styleClass="disp,s34"
                                       text="ARTISTAS"/>
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <HBox alignment="CENTER_LEFT"
                              prefHeight="40"
                              prefWidth="280"
                              spacing="10"
                              styleClass="field">
                            <children>
                                <Region maxHeight="19" maxWidth="19"
                                        minHeight="19" minWidth="19"
                                        prefHeight="19" prefWidth="19"
                                        styleClass="icon,ic-search"/>

                                <TextField fx:id="txtBuscar"
                                           promptText="Buscar artista, género o agencia"
                                           styleClass="field-input"
                                           HBox.hgrow="ALWAYS"/>
                            </children>
                        </HBox>

                        <Button id="btnNuevoArtista"
                                fx:id="btnCrear_Artista"
                                graphicTextGap="8"
                                mnemonicParsing="false"
                                prefHeight="40"
                                styleClass="btn-primary"
                                text="Nuevo artista">
                            <graphic>
                                <Region maxHeight="18" maxWidth="18"
                                        minHeight="18" minWidth="18"
                                        prefHeight="18" prefWidth="18"
                                        styleClass="icon,ic-add,ic-dark"/>
                            </graphic>
                        </Button>
                    </children>
                </HBox>

                <!-- TABLA DINÁMICA -->
                <VBox styleClass="table" VBox.vgrow="ALWAYS">
                    <VBox.margin>
                        <Insets bottom="24" left="28" right="28"/>
                    </VBox.margin>

                    <children>
                        <GridPane fx:id="gridEncabezado"
                                  hgap="12"
                                  styleClass="thead">
                            <columnConstraints>
                                <ColumnConstraints maxWidth="50.0"
                                                   minWidth="50.0"
                                                   prefWidth="50.0"/>
                                <ColumnConstraints hgrow="ALWAYS"
                                                   maxWidth="382.0"
                                                   minWidth="10.0"
                                                   prefWidth="357.6"/>
                                <ColumnConstraints hgrow="ALWAYS"
                                                   maxWidth="422.8"
                                                   minWidth="10.0"
                                                   prefWidth="268.8"/>
                                <ColumnConstraints hgrow="ALWAYS"
                                                   maxWidth="413.2"
                                                   minWidth="10.0"
                                                   prefWidth="259.2"/>
                                <ColumnConstraints halignment="RIGHT"
                                                   maxWidth="72.0"
                                                   minWidth="72.0"
                                                   prefWidth="72.0"/>
                            </columnConstraints>

                            <padding>
                                <Insets bottom="11" left="18"
                                        right="18" top="11"/>
                            </padding>

                            <children>
                                <Label styleClass="th"
                                       text="ID"
                                       GridPane.columnIndex="0"/>

                                <Label styleClass="th"
                                       text="NOMBRE ARTÍSTICO"
                                       GridPane.columnIndex="1"/>

                                <Label styleClass="th"
                                       text="GÉNERO MUSICAL"
                                       GridPane.columnIndex="2"/>

                                <Label styleClass="th"
                                       text="AGENCIA"
                                       GridPane.columnIndex="3"/>

                                <Label styleClass="th"
                                       GridPane.columnIndex="4"/>
                            </children>

                            <rowConstraints>
                                <RowConstraints/>
                            </rowConstraints>
                        </GridPane>

                        <ScrollPane fitToWidth="true"
                                    styleClass="scroll"
                                    VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="contenedorFilas"
                                      spacing="0"/>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>