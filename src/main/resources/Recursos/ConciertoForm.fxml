<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      prefHeight="768"
      prefWidth="640"
      styleClass="sheet"
      stylesheets="@../com/umg/api/ui/styles.css"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1">

    <children>

        <HBox alignment="CENTER_LEFT"
              prefHeight="0.0"
              prefWidth="501.0"
              styleClass="detail-head">

            <padding>
                <Insets bottom="14" left="26" right="26" top="20"/>
            </padding>

            <children>
                <Label styleClass="disp,s28" text="NUEVO CONCIERTO"/>
                <Region HBox.hgrow="ALWAYS"/>

                <Button id="cerrar"
                        fx:id="cerrar"
                        cancelButton="true"
                        graphicTextGap="8"
                        mnemonicParsing="false"
                        styleClass="btn-icon">

                    <graphic>
                        <Region maxHeight="18"
                                maxWidth="18"
                                minHeight="18"
                                minWidth="18"
                                prefHeight="18"
                                prefWidth="18"
                                styleClass="icon,ic-close,ic-muted"/>
                    </graphic>
                </Button>
            </children>
        </HBox>

        <ScrollPane fitToWidth="true"
                    prefHeight="290.0"
                    prefWidth="639.0"
                    styleClass="scroll"
                    VBox.vgrow="ALWAYS">

            <content>
                <VBox spacing="14">

                    <padding>
                        <Insets bottom="18" left="26" right="26" top="18"/>
                    </padding>

                    <children>

                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <children>

                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="form-lbl"
                                               text="Artista principal"/>

                                        <ComboBox fx:id="cmbArtista"
                                                  maxWidth="Infinity"
                                                  prefHeight="42"
                                                  styleClass="combo"/>
                                    </children>
                                </VBox>

                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="form-lbl"
                                               text="Título de la gira"/>

                                        <TextField fx:id="txtGira"
                                                   prefHeight="42"
                                                   promptText="Nombre de la gira"
                                                   styleClass="input"
                                                   text="Gira Magma 2026"/>
                                    </children>
                                </VBox>

                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <children>

                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="form-lbl"
                                               text="Fecha"/>

                                        <DatePicker fx:id="dpFecha"
                                                    maxWidth="Infinity"
                                                    prefHeight="42"
                                                    promptText="10/10/2026"
                                                    styleClass="date"/>
                                    </children>
                                </VBox>

                                <VBox spacing="6">
                                    <children>
                                        <Label styleClass="form-lbl"
                                               text="Hora"/>

                                        <TextField fx:id="txtHora"
                                                   maxWidth="110"
                                                   prefHeight="42"
                                                   prefWidth="110"
                                                   promptText="20:00"
                                                   styleClass="input"
                                                   text="20:00"/>
                                    </children>
                                </VBox>

                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="form-lbl"
                                               text="Estado"/>

                                        <ComboBox fx:id="cmbEstado"
                                                  maxWidth="Infinity"
                                                  prefHeight="42"
                                                  styleClass="combo">

                                            <items>
                                                <FXCollections fx:factory="observableArrayList">
                                                    <String fx:value="En venta"/>
                                                    <String fx:value="Programado"/>
                                                    <String fx:value="Agotado"/>
                                                    <String fx:value="Finalizado"/>
                                                    <String fx:value="Cancelado"/>
                                                </FXCollections>
                                            </items>

                                            <value>
                                                <String fx:value="En venta"/>
                                            </value>
                                        </ComboBox>
                                    </children>
                                </VBox>

                            </children>
                        </HBox>

                        <VBox spacing="6">
                            <children>
                                <Label styleClass="form-lbl"
                                       text="Recinto"/>

                                <ComboBox fx:id="cmbEstadio"
                                          maxWidth="Infinity"
                                          prefHeight="42"
                                          styleClass="combo"/>
                            </children>
                        </VBox>

                        <VBox spacing="3">
                            <padding>
                                <Insets bottom="0" left="0" right="0" top="6"/>
                            </padding>
                        </VBox>

                        <VBox>
                            <children>

                                <GridPane hgap="10">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="26" prefWidth="26"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                        <ColumnConstraints minWidth="170" prefWidth="170"/>
                                        <ColumnConstraints minWidth="110" prefWidth="110"/>
                                        <ColumnConstraints minWidth="110" prefWidth="110"/>
                                    </columnConstraints>

                                    <padding>
                                        <Insets bottom="8" left="0" right="0" top="0"/>
                                    </padding>
                                </GridPane>

                                <GridPane hgap="10" styleClass="inv-row">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="26" prefWidth="26"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                        <ColumnConstraints minWidth="170" prefWidth="170"/>
                                        <ColumnConstraints minWidth="110" prefWidth="110"/>
                                        <ColumnConstraints minWidth="110" prefWidth="110"/>
                                    </columnConstraints>

                                    <padding>
                                        <Insets bottom="9" left="0" right="0" top="9"/>
                                    </padding>
                                </GridPane>

                            </children>
                        </VBox>

                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <children>

                                <VBox fx:id="vbAforo_Total"
                                      maxWidth="Infinity"
                                      styleClass="line-box"
                                      HBox.hgrow="ALWAYS">

                                    <padding>
                                        <Insets bottom="12" left="14" right="14" top="12"/>
                                    </padding>

                                    <children>
                                        <Label styleClass="s11,w600,c-dim"
                                               text="Aforo total"/>

                                        <Label fx:id="Capacidad"
                                               styleClass="disp,s24"
                                               text="762 personas"/>
                                    </children>
                                </VBox>

                            </children>
                        </HBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>

        <HBox alignment="CENTER_RIGHT"
              prefHeight="214.0"
              prefWidth="639.0"
              spacing="10"
              styleClass="detail-foot">

            <padding>
                <Insets bottom="18" left="26" right="26" top="14"/>
            </padding>

            <children>
                <Button fx:id="btnCancelar"
                        graphicTextGap="8"
                        mnemonicParsing="false"
                        prefHeight="44"
                        styleClass="btn-ghost"
                        text="Cancelar"/>

                <Button fx:id="btnGuardar"
                        defaultButton="true"
                        graphicTextGap="8"
                        mnemonicParsing="false"
                        prefHeight="44"
                        styleClass="btn-primary"
                        text="Guardar concierto"/>
            </children>
        </HBox>

    </children>
</VBox>
