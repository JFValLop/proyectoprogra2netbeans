<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Factura" pageWidth="612" pageHeight="792" columnWidth="540" leftMargin="36" rightMargin="36" topMargin="36" bottomMargin="36">

	<parameter name="VENTA_ID" class="java.lang.Integer"/>
	<parameter name="COMPANIA" class="java.lang.String">
		<defaultValueExpression><![CDATA["Billets - Venta de boletos"]]></defaultValueExpression>
	</parameter>
	<parameter name="LEMA" class="java.lang.String">
		<defaultValueExpression><![CDATA["Tus conciertos favoritos, en un solo lugar"]]></defaultValueExpression>
	</parameter>
	<parameter name="DIRECCION" class="java.lang.String">
		<defaultValueExpression><![CDATA["Guatemala, Guatemala"]]></defaultValueExpression>
	</parameter>
	<parameter name="TELEFONO" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>

	<queryString>
		<![CDATA[SELECT f.id AS factura_id,
       'FAC-' || LPAD(f.id::text, 6, '0') AS numero_factura,
       f."ventaId" AS venta_id,
       f.nit,
       f.nombre,
       f.total,
       f."createdAt" AS fecha,
       v."metodoPago" AS metodo_pago,
       v."montoRecibido" AS monto_recibido,
       v.autorizacion,
       COALESCE(u.nombre, u.usuario) AS vendedor,
       ar.nombre AS artista,
       l.nombre AS localidad,
       a.bloque,
       a.filas AS fila,
       a.numero AS asiento,
       b.precio
  FROM facturas f
  JOIN ventas v ON v.id = f."ventaId"
  LEFT JOIN usuarios u ON u.id = v."usuarioId"
  JOIN boletos b ON b."ventaId" = v.id
  LEFT JOIN asientos a ON a.id = b."asientoId"
  LEFT JOIN localidades l ON l.id = COALESCE(a."localidadId", b."localidadId")
  JOIN conciertos c ON c.id = b."conciertoId"
  LEFT JOIN artista ar ON ar.id = c."artistaId"
 WHERE f."ventaId" = $P{VENTA_ID}
 ORDER BY b.id]]>
	</queryString>

	<field name="factura_id" class="java.lang.Integer"/>
	<field name="numero_factura" class="java.lang.String"/>
	<field name="venta_id" class="java.lang.Integer"/>
	<field name="nit" class="java.lang.String"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="total" class="java.math.BigDecimal"/>
	<field name="fecha" class="java.sql.Timestamp"/>
	<field name="metodo_pago" class="java.lang.String"/>
	<field name="monto_recibido" class="java.math.BigDecimal"/>
	<field name="autorizacion" class="java.lang.String"/>
	<field name="vendedor" class="java.lang.String"/>
	<field name="artista" class="java.lang.String"/>
	<field name="localidad" class="java.lang.String"/>
	<field name="bloque" class="java.lang.String"/>
	<field name="fila" class="java.lang.String"/>
	<field name="asiento" class="java.lang.Integer"/>
	<field name="precio" class="java.math.BigDecimal"/>

	<!-- Precios con IVA incluido (12%): subtotal = total / 1.12 -->
	<variable name="SUBTOTAL" class="java.math.BigDecimal" calculation="Nothing">
		<variableExpression><![CDATA[$F{total}.divide(new java.math.BigDecimal("1.12"), 2, java.math.RoundingMode.HALF_UP)]]></variableExpression>
	</variable>
	<variable name="IVA" class="java.math.BigDecimal" calculation="Nothing">
		<variableExpression><![CDATA[$F{total}.subtract($V{SUBTOTAL})]]></variableExpression>
	</variable>

	<group name="Factura">
		<groupExpression><![CDATA[$F{factura_id}]]></groupExpression>

		<groupHeader>
			<band height="200">
				<!-- Compañía -->
				<textField>
					<reportElement x="0" y="0" width="340" height="24"/>
					<textElement verticalAlignment="Middle"><font size="16" isBold="true"/></textElement>
					<textFieldExpression><![CDATA[$P{COMPANIA}]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="0" y="26" width="340" height="12" forecolor="#595959"/>
					<textElement><font size="8" isItalic="true"/></textElement>
					<textFieldExpression><![CDATA[$P{LEMA}]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="0" y="44" width="340" height="12"/>
					<textElement><font size="9"/></textElement>
					<textFieldExpression><![CDATA[$P{DIRECCION}]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement x="0" y="57" width="340" height="12"/>
					<textElement><font size="9"/></textElement>
					<textFieldExpression><![CDATA[$P{TELEFONO}.isEmpty() ? "" : "Teléfono: " + $P{TELEFONO}]]></textFieldExpression>
				</textField>

				<!-- Título -->
				<staticText>
					<reportElement x="350" y="0" width="190" height="34" forecolor="#7F7F7F"/>
					<textElement textAlignment="Right" verticalAlignment="Middle"><font size="26" isBold="true"/></textElement>
					<text><![CDATA[FACTURA]]></text>
				</staticText>

				<!-- Fecha / número de factura / número de venta -->
				<staticText>
					<reportElement x="350" y="42" width="90" height="14"/>
					<textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
					<text><![CDATA[Fecha:]]></text>
				</staticText>
				<textField>
					<reportElement mode="Opaque" x="445" y="42" width="95" height="14" backcolor="#E7E6E6"/>
					<box><pen lineWidth="0.5" lineColor="#A6A6A6"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement>
					<textFieldExpression><![CDATA[new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format($F{fecha})]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement x="350" y="58" width="90" height="14"/>
					<textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
					<text><![CDATA[N° de Factura]]></text>
				</staticText>
				<textField>
					<reportElement mode="Opaque" x="445" y="58" width="95" height="14" backcolor="#E7E6E6"/>
					<box><pen lineWidth="0.5" lineColor="#A6A6A6"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement>
					<textFieldExpression><![CDATA[$F{numero_factura}]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement x="350" y="74" width="90" height="14"/>
					<textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
					<text><![CDATA[N° de Venta]]></text>
				</staticText>
				<textField>
					<reportElement mode="Opaque" x="445" y="74" width="95" height="14" backcolor="#E7E6E6"/>
					<box><pen lineWidth="0.5" lineColor="#A6A6A6"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement>
					<textFieldExpression><![CDATA["V-" + String.format("%06d", $F{venta_id})]]></textFieldExpression>
				</textField>

				<!-- Facturar a -->
				<staticText>
					<reportElement mode="Opaque" x="0" y="106" width="200" height="14" forecolor="#FFFFFF" backcolor="#595959"/>
					<textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
					<text><![CDATA[ FACTURAR A:]]></text>
				</staticText>
				<textField isBlankWhenNull="true">
					<reportElement x="0" y="123" width="340" height="12"/>
					<textElement><font size="9"/></textElement>
					<textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement x="0" y="136" width="340" height="12"/>
					<textElement><font size="9"/></textElement>
					<textFieldExpression><![CDATA["NIT: " + $F{nit}]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement x="0" y="149" width="340" height="12"/>
					<textElement><font size="9"/></textElement>
					<textFieldExpression><![CDATA["Atendido por: " + ($F{vendedor} == null ? "-" : $F{vendedor})]]></textFieldExpression>
				</textField>

				<!-- Encabezado de la tabla -->
				<staticText>
					<reportElement mode="Opaque" x="0" y="176" width="440" height="16" forecolor="#FFFFFF" backcolor="#595959"/>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
					<text><![CDATA[DESCRIPCIÓN]]></text>
				</staticText>
				<staticText>
					<reportElement mode="Opaque" x="440" y="176" width="100" height="16" forecolor="#FFFFFF" backcolor="#595959"/>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
					<text><![CDATA[TOTAL]]></text>
				</staticText>
			</band>
		</groupHeader>

		<groupFooter>
			<band height="230">
				<line>
					<reportElement x="0" y="0" width="540" height="1"/>
					<graphicElement><pen lineWidth="0.5" lineColor="#A6A6A6"/></graphicElement>
				</line>

				<!-- Comentarios (forma de pago) -->
				<staticText>
					<reportElement mode="Opaque" x="0" y="20" width="270" height="14" backcolor="#BFBFBF"/>
					<box><pen lineWidth="0.5" lineColor="#A6A6A6"/></box>
					<textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
					<text><![CDATA[ COMENTARIOS]]></text>
				</staticText>
				<rectangle>
					<reportElement x="0" y="34" width="270" height="62"/>
					<graphicElement><pen lineWidth="0.5" lineColor="#A6A6A6"/></graphicElement>
				</rectangle>
				<textField isBlankWhenNull="true">
					<reportElement x="4" y="38" width="262" height="12"/>
					<textElement><font size="9"/></textElement>
					<textFieldExpression><![CDATA["1. Forma de pago: " + ($F{metodo_pago} == null ? "-" : $F{metodo_pago})]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement x="4" y="52" width="262" height="12"/>
					<textElement><font size="9"/></textElement>
					<textFieldExpression><![CDATA["TARJETA".equals($F{metodo_pago})
	? "2. Pagado en terminal POS"
	: ($F{monto_recibido} == null ? ""
		: "2. Recibido: Q " + new java.text.DecimalFormat("#,##0.00").format($F{monto_recibido})
		  + "   Cambio: Q " + new java.text.DecimalFormat("#,##0.00").format($F{monto_recibido}.subtract($F{total})))]]></textFieldExpression>
				</textField>

				<!-- Totales -->
				<staticText>
					<reportElement x="330" y="20" width="110" height="14"/>
					<textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
					<text><![CDATA[SUBTOTAL]]></text>
				</staticText>
				<textField>
					<reportElement mode="Opaque" x="445" y="20" width="95" height="14" backcolor="#E7E6E6"/>
					<textElement textAlignment="Right" verticalAlignment="Middle"><font size="9"/></textElement>
					<textFieldExpression><![CDATA["Q " + new java.text.DecimalFormat("#,##0.00").format($V{SUBTOTAL}) + " "]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement x="330" y="36" width="110" height="14"/>
					<textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
					<text><![CDATA[IVA 12% (incluido)]]></text>
				</staticText>
				<textField>
					<reportElement mode="Opaque" x="445" y="36" width="95" height="14" backcolor="#E7E6E6"/>
					<textElement textAlignment="Right" verticalAlignment="Middle"><font size="9"/></textElement>
					<textFieldExpression><![CDATA["Q " + new java.text.DecimalFormat("#,##0.00").format($V{IVA}) + " "]]></textFieldExpression>
				</textField>
				<line>
					<reportElement x="330" y="54" width="210" height="1"/>
					<graphicElement><pen lineWidth="1" lineColor="#595959"/></graphicElement>
				</line>
				<staticText>
					<reportElement x="330" y="58" width="110" height="16"/>
					<textElement textAlignment="Right" verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
					<text><![CDATA[TOTAL]]></text>
				</staticText>
				<textField>
					<reportElement mode="Opaque" x="445" y="58" width="95" height="16" backcolor="#E7E6E6"/>
					<textElement textAlignment="Right" verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
					<textFieldExpression><![CDATA["Q " + new java.text.DecimalFormat("#,##0.00").format($F{total}) + " "]]></textFieldExpression>
				</textField>

				<!-- Pie -->
				<staticText>
					<reportElement x="0" y="124" width="540" height="12" forecolor="#595959"/>
					<textElement textAlignment="Center"><font size="8"/></textElement>
					<text><![CDATA[Factura interna del sistema de venta de boletos. No sustituye una factura electrónica (FEL).]]></text>
				</staticText>
				<staticText>
					<reportElement x="0" y="150" width="540" height="18"/>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font size="12" isBold="true" isItalic="true"/></textElement>
					<text><![CDATA[¡Gracias por su compra!]]></text>
				</staticText>
			</band>
		</groupFooter>
	</group>

	<detail>
		<band height="16">
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="0" width="440" height="16"/>
				<box leftPadding="4"><leftPen lineWidth="0.5" lineColor="#A6A6A6"/><rightPen lineWidth="0.5" lineColor="#A6A6A6"/></box>
				<textElement verticalAlignment="Middle"><font size="9"/></textElement>
				<textFieldExpression><![CDATA[($F{artista} == null ? "Concierto" : $F{artista})
	+ " - " + ($F{localidad} == null ? "General" : $F{localidad})
	+ ($F{fila} == null
		? " (de pie)"
		: ($F{bloque} == null ? "" : " - Bloque " + $F{bloque}) + " - Fila " + $F{fila} + " Asiento " + $F{asiento})]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="440" y="0" width="100" height="16"/>
				<box rightPadding="4"><rightPen lineWidth="0.5" lineColor="#A6A6A6"/></box>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font size="9"/></textElement>
				<textFieldExpression><![CDATA[$F{precio} == null ? "" : "Q " + new java.text.DecimalFormat("#,##0.00").format($F{precio})]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>
