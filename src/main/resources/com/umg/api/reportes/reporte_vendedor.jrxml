<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reporte_vendedor" pageWidth="595" pageHeight="842" whenNoDataType="NoDataSection" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30" uuid="842a019b-da0b-47a8-9f3a-435f133a4319">
	<parameter name="P_DESDE" class="java.sql.Date"/>
	<parameter name="P_HASTA" class="java.sql.Date"/>
	<parameter name="P_CONCIERTO" class="java.lang.Integer"/>
	<parameter name="P_ARTISTA" class="java.lang.Integer"/>
	<parameter name="P_VENDEDOR" class="java.lang.Integer"/>
	<parameter name="P_CODIGO" class="java.lang.String"/>
	<parameter name="P_GENERADO_POR" class="java.lang.String"/>
	<parameter name="P_FILTROS" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT u.nombre || ' · ' || COALESCE(u.rol, '')  AS vendedor,
       COUNT(DISTINCT v.id)                      AS transacciones,
       COUNT(b.id)                               AS boletos,
       COALESCE(SUM(b.precio), 0)                AS total
FROM ventas v
JOIN usuarios  u ON u.id = v."usuarioId"
JOIN boletos   b ON b."ventaId" = v.id
JOIN conciertos c ON c.id = b."conciertoId"
WHERE (v."createdAt" AT TIME ZONE 'America/Guatemala')::date
        BETWEEN $P{P_DESDE} AND $P{P_HASTA}
  AND (CAST($P{P_CONCIERTO} AS INTEGER) IS NULL OR c.id = $P{P_CONCIERTO})
  AND (CAST($P{P_ARTISTA}   AS INTEGER) IS NULL OR c."artistaId" = $P{P_ARTISTA})
  AND (CAST($P{P_VENDEDOR}  AS INTEGER) IS NULL OR u.id = $P{P_VENDEDOR})
GROUP BY u.id, u.nombre, u.rol
ORDER BY u.nombre]]>
	</queryString>
	<field name="vendedor" class="java.lang.String"/>
	<field name="transacciones" class="java.lang.Long"/>
	<field name="boletos" class="java.lang.Long"/>
	<field name="total" class="java.math.BigDecimal"/>
	<variable name="V_TRANS" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{transacciones}]]></variableExpression>
	</variable>
	<variable name="V_BOLETOS" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{boletos}]]></variableExpression>
	</variable>
	<variable name="V_TOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total}]]></variableExpression>
	</variable>
