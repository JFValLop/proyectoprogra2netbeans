<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reporte_artista" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30" whenNoDataType="NoDataSection">
	<parameter name="P_DESDE" class="java.sql.Date"/>
	<parameter name="P_HASTA" class="java.sql.Date"/>
	<parameter name="P_CONCIERTO" class="java.lang.Integer"/>
	<parameter name="P_ARTISTA" class="java.lang.Integer"/>
	<parameter name="P_VENDEDOR" class="java.lang.Integer"/>
	<parameter name="P_CODIGO" class="java.lang.String"/>
	<parameter name="P_GENERADO_POR" class="java.lang.String"/>
	<parameter name="P_FILTROS" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT a.nombre || ' · ' || COALESCE(a.genero, '') AS artista,
       COUNT(DISTINCT c.id)                        AS conciertos,
       COUNT(DISTINCT v.id)                        AS transacciones,
       COUNT(b.id)                                 AS boletos,
       COALESCE(SUM(b.precio), 0)                  AS total
FROM ventas v
JOIN boletos    b ON b."ventaId" = v.id
JOIN conciertos c ON c.id = b."conciertoId"
JOIN artista    a ON a.id = c."artistaId"
WHERE (v."createdAt" AT TIME ZONE 'America/Guatemala')::date
        BETWEEN $P{P_DESDE} AND $P{P_HASTA}
  AND (CAST($P{P_CONCIERTO} AS INTEGER) IS NULL OR c.id = $P{P_CONCIERTO})
  AND (CAST($P{P_ARTISTA}   AS INTEGER) IS NULL OR a.id = $P{P_ARTISTA})
  AND (CAST($P{P_VENDEDOR}  AS INTEGER) IS NULL OR v."usuarioId" = $P{P_VENDEDOR})
GROUP BY a.id, a.nombre, a.genero
ORDER BY total DESC]]>
	</queryString>
	<field name="artista" class="java.lang.String"/>
	<field name="conciertos" class="java.lang.Long"/>
	<field name="transacciones" class="java.lang.Long"/>
	<field name="boletos" class="java.lang.Long"/>
	<field name="total" class="java.math.BigDecimal"/>
	<variable name="V_TRANSACCIONES" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{transacciones}]]></variableExpression>
	</variable>
	<variable name="V_BOLETOS" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{boletos}]]></variableExpression>
	</variable>
	<variable name="V_TOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total}]]></variableExpression>
	</variable>
	<title>
		<band height="112">
			<staticText>
				<reportElement x="0" y="0" width="250" height="34"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="26" isBold="true"/></textElement>
				<text><![CDATA[SVB·GUA]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="34" width="250" height="14" forecolor="#666666"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="7" isBold="false"/></textElement>
				<text><![CDATA[SISTEMA DE VENTA DE BOLETOS]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="265" y="6" width="250" height="14" forecolor="#444444"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="7" isBold="false"/></textElement>
				<textFieldExpression><![CDATA[$P{P_CODIGO}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="215" y="20" width="300" height="14" forecolor="#444444"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="7" isBold="false"/></textElement>
				<textFieldExpression><![CDATA["Generado " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date()) + " por " + $P{P_GENERADO_POR}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="58" width="515" height="1"/>
				<graphicElement><pen lineWidth="1.5"/></graphicElement>
			</line>
			<staticText>
				<reportElement x="0" y="68" width="515" height="26"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="16" isBold="true"/></textElement>
				<text><![CDATA[REPORTE DE VENTAS POR ARTISTA]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="94" width="515" height="14" forecolor="#444444"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false"/></textElement>
				<textFieldExpression><![CDATA["Periodo: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{P_DESDE}) + " al " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{P_HASTA}) + " · Filtros: " + $P{P_FILTROS}]]></textFieldExpression>
			</textField>
		</band>
	</title>
