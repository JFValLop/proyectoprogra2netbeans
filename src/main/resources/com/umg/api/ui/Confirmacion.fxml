<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<BorderPane prefWidth="1366" prefHeight="768" styleClass="app" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@styles.css" fx:controller="com.umg.api.ui.ConfirmacionController">
  <center>
    <VBox spacing="16">
      <padding><Insets top="22" right="28" bottom="20" left="28"/></padding>
      <children>
        <HBox alignment="CENTER_LEFT" spacing="14">
          <children>
            <StackPane styleClass="ok-badge" minWidth="48" minHeight="48" prefWidth="48" prefHeight="48" maxWidth="48" maxHeight="48">
              <children>
                <Region styleClass="icon,ic-check-circle,ic-green" minWidth="28" minHeight="28" prefWidth="28" prefHeight="28" maxWidth="28" maxHeight="28"/>
              </children>
            </StackPane>
            <VBox HBox.hgrow="ALWAYS">
              <children>
                <Label text="VENTA V-004823 REGISTRADA" styleClass="disp,s32" fx:id="lblTitulo"/>
                <Label text="lun 28 sep 2026 · 14:06 · José López · Taquilla 1 · Cliente: Ana Pérez" styleClass="s13,c-muted" fx:id="lblDetalle"/>
              </children>
            </VBox>
            <Button text="Imprimir boletos" styleClass="btn-ghost" mnemonicParsing="false" graphicTextGap="8" fx:id="btnImprimir">
              <graphic>
                <Region styleClass="icon,ic-print,ic-text" minWidth="18" minHeight="18" prefWidth="18" prefHeight="18" maxWidth="18" maxHeight="18"/>
              </graphic>
            </Button>
            <Button text="Reenviar por correo" styleClass="btn-ghost" mnemonicParsing="false" graphicTextGap="8" fx:id="btnReenviar">
              <graphic>
                <Region styleClass="icon,ic-mail,ic-text" minWidth="18" minHeight="18" prefWidth="18" prefHeight="18" maxWidth="18" maxHeight="18"/>
              </graphic>
            </Button>
          </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="12">
          <children>
            <VBox styleClass="stat" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="4">
              <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
              <children>
                <Label text="Total cobrado" styleClass="s11,w600,c-dim"/>
                <Label text="Q 3,150.00" styleClass="disp,s28" fx:id="lblTotal"/>
              </children>
            </VBox>
            <VBox styleClass="stat" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="4">
              <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
              <children>
                <Label text="Método de pago" styleClass="s11,w600,c-dim"/>
                <Label text="Efectivo" styleClass="s16,w600" fx:id="lblMetodo"/>
              </children>
            </VBox>
            <VBox styleClass="stat" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="4" fx:id="statRecibido">
              <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
              <children>
                <Label text="Recibido" styleClass="s11,w600,c-dim"/>
                <Label text="Q 4,000.00" styleClass="disp,s28" fx:id="lblRecibido"/>
              </children>
            </VBox>
            <VBox styleClass="stat-accent" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="4" fx:id="statCambio">
              <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
              <children>
                <Label text="Cambio a entregar" styleClass="s11,w600,c-amber"/>
                <Label text="Q 850.00" styleClass="disp,s28,c-amber" fx:id="lblCambio"/>
              </children>
            </VBox>
          </children>
        </HBox>
        <HBox alignment="CENTER_LEFT">
          <children>
            <Label text="3 boletos generados" styleClass="s13,w700" fx:id="lblCantidad"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Impresos en taquilla · Enviados a ana.perez@gmail.com · cada boleto lleva un QR único para validar el acceso" styleClass="s12,c-dim" fx:id="lblEntrega"/>
          </children>
        </HBox>
        <GridPane hgap="14" vgap="14" VBox.vgrow="ALWAYS" fx:id="gridBoletos">
          <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33"/>
          </columnConstraints>
          <children>
          </children>
        </GridPane>
        <HBox alignment="CENTER_RIGHT" spacing="10">
          <children>
            <Button text="Vender otra para este concierto" styleClass="btn-ghost,btn-lg" mnemonicParsing="false" graphicTextGap="8" fx:id="btnOtraVenta"/>
            <Button text="Nueva venta  ·  F2" styleClass="btn-primary,btn-lg" mnemonicParsing="false" graphicTextGap="8" defaultButton="true" fx:id="btnNuevaVenta"/>
          </children>
        </HBox>
      </children>
    </VBox>
  </center>
</BorderPane>
