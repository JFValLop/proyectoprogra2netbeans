<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<HBox alignment="TOP_LEFT" prefWidth="900" prefHeight="620" styleClass="dialog" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@styles.css" fx:controller="com.umg.api.ui.CobroController">
  <fx:define>
    <ToggleGroup fx:id="grupoMetodo"/>
  </fx:define>
  <children>
    <VBox prefWidth="320" minWidth="320" spacing="12" styleClass="dialog-side">
      <padding><Insets top="22" right="22" bottom="22" left="22"/></padding>
      <children>
        <Label text="RESUMEN · 3 BOLETOS" styleClass="eyebrow" fx:id="lblResumen"/>
        <Label text="SOFÍA LEMUS" styleClass="disp,s22" fx:id="lblArtista"/>
        <Label text="vie 16 oct 2026 · 19:30 h · Gran Sala · Teatro Nacional" styleClass="s12,c-muted" wrapText="true" fx:id="lblDetalle"/>
        <VBox VBox.vgrow="ALWAYS" fx:id="lineasResumen">
          <children>
          </children>
        </VBox>
        <HBox alignment="BASELINE_LEFT">
          <children>
            <Label text="TOTAL" styleClass="s11,w700,c-dim"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Q 3,150.00" styleClass="disp,s34" fx:id="lblTotal"/>
          </children>
        </HBox>
      </children>
    </VBox>
    <VBox HBox.hgrow="ALWAYS" spacing="16">
      <padding><Insets top="22" right="26" bottom="22" left="26"/></padding>
      <children>
        <HBox alignment="CENTER_LEFT">
          <children>
            <Label text="COBRO" styleClass="disp,s26"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button styleClass="btn-icon" mnemonicParsing="false" graphicTextGap="8" id="btnCerrarCobro" fx:id="btnCerrarCobro">
              <graphic>
                <Region styleClass="icon,ic-close,ic-muted" minWidth="18" minHeight="18" prefWidth="18" prefHeight="18" maxWidth="18" maxHeight="18"/>
              </graphic>
            </Button>
          </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10">
          <children>
            <ToggleButton toggleGroup="$grupoMetodo" selected="true" styleClass="tile" mnemonicParsing="false" maxWidth="Infinity" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" fx:id="tglEfectivo">
              <graphic>
                <HBox alignment="CENTER_LEFT" spacing="12">
                  <children>
                    <Region styleClass="icon,ic-payments,ic-amber" minWidth="26" minHeight="26" prefWidth="26" prefHeight="26" maxWidth="26" maxHeight="26"/>
                    <VBox>
                      <children>
                        <Label text="Efectivo" styleClass="s14,w700"/>
                        <Label text="Cobro en caja" styleClass="s12,c-dim"/>
                      </children>
                    </VBox>
                  </children>
                </HBox>
              </graphic>
            </ToggleButton>
            <ToggleButton toggleGroup="$grupoMetodo" styleClass="tile" mnemonicParsing="false" maxWidth="Infinity" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" fx:id="tglTarjeta">
              <graphic>
                <HBox alignment="CENTER_LEFT" spacing="12">
                  <children>
                    <Region styleClass="icon,ic-card,ic-muted" minWidth="26" minHeight="26" prefWidth="26" prefHeight="26" maxWidth="26" maxHeight="26"/>
                    <VBox>
                      <children>
                        <Label text="Tarjeta (POS)" styleClass="s14,w700"/>
                        <Label text="Terminal externa" styleClass="s12,c-dim"/>
                      </children>
                    </VBox>
                  </children>
                </HBox>
              </graphic>
            </ToggleButton>
          </children>
        </HBox>
        <VBox id="panelEfectivo" spacing="10" fx:id="panelEfectivo">
          <children>
            <HBox alignment="BOTTOM_LEFT" spacing="12">
              <children>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                  <children>
                    <Label text="Monto recibido" styleClass="form-lbl"/>
                    <HBox alignment="CENTER_LEFT" styleClass="field" spacing="8" prefHeight="52">
                      <children>
                        <Label text="Q" styleClass="s18,w700,c-dim"/>
                        <TextField id="txtRecibido" text="" styleClass="field-input,input-money" HBox.hgrow="ALWAYS" fx:id="txtRecibido"/>
                      </children>
                    </HBox>
                  </children>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" prefHeight="52" alignment="CENTER_LEFT">
                  <children>
                    <Label text="Cambio a entregar" styleClass="s12,w600,c-muted"/>
                    <Label text="Q 850.00" styleClass="disp,s28,c-green" fx:id="lblCambio"/>
                  </children>
                </VBox>
              </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8">
              <children>
                <Button text="Exacto" styleClass="btn-chip" mnemonicParsing="false" graphicTextGap="8" fx:id="btnExacto"/>
                <Button text="Q 3,200" styleClass="btn-chip" mnemonicParsing="false" graphicTextGap="8" fx:id="btnMonto1"/>
                <Button text="Q 3,500" styleClass="btn-chip" mnemonicParsing="false" graphicTextGap="8" fx:id="btnMonto2"/>
                <Button text="Q 4,000" styleClass="btn-chip" mnemonicParsing="false" graphicTextGap="8" fx:id="btnMonto3"/>
              </children>
            </HBox>
          </children>
        </VBox>
        <VBox id="panelTarjeta" spacing="10" visible="false" managed="false" fx:id="panelTarjeta">
          <children>
            <HBox alignment="CENTER_LEFT" styleClass="note" spacing="10">
              <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
              <children>
                <Region styleClass="icon,ic-info,ic-amber" minWidth="19" minHeight="19" prefWidth="19" prefHeight="19" maxWidth="19" maxHeight="19"/>
                <Label text="Procesa el cobro en la terminal POS y confirma la venta cuando el pago sea aprobado." styleClass="s12,c-text2" wrapText="true"/>
              </children>
            </HBox>
          </children>
        </VBox>
        <VBox spacing="8">
          <children>
            <Label text="Entrega de boletos" styleClass="form-lbl"/>
            <HBox alignment="CENTER_LEFT" spacing="16">
              <children>
                <CheckBox id="chkCorreo" text="Enviar QR por correo" selected="true" mnemonicParsing="false" fx:id="chkCorreo"/>
              </children>
            </HBox>
            <TextField promptText="correo@cliente.com" text="" styleClass="input" prefHeight="42" id="txtCorreo" fx:id="txtCorreo"/>
          </children>
        </VBox>
        <VBox spacing="6">
          <children>
            <Label text="NIT, CUI o CF" styleClass="form-lbl"/>
            <HBox alignment="CENTER_LEFT" spacing="8">
              <children>
                <TextField fx:id="txtNit" promptText="CF" styleClass="input" prefHeight="42" HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnBuscarNit" text="Buscar" styleClass="btn-ghost" prefHeight="42" mnemonicParsing="false"/>
              </children>
            </HBox>
            <Label fx:id="lblClienteEstado" styleClass="s11,c-dim"/>
          </children>
        </VBox>
        <VBox spacing="6">
          <children>
            <Label text="Nombre del cliente" styleClass="form-lbl"/>
            <TextField promptText="Para el comprobante" text="" styleClass="input" prefHeight="42" id="txtCliente" fx:id="txtCliente"/>
          </children>
        </VBox>
        <Region VBox.vgrow="ALWAYS"/>
        <HBox alignment="CENTER_RIGHT" spacing="10">
          <children>
            <Button text="Cancelar" styleClass="btn-ghost,btn-lg" mnemonicParsing="false" graphicTextGap="8" cancelButton="true" fx:id="btnCancelar"/>
            <Button text="Confirmar venta · Q 3,150.00" styleClass="btn-primary,btn-lg" mnemonicParsing="false" graphicTextGap="8" id="btnConfirmarVenta" defaultButton="true" fx:id="btnConfirmarVenta">
              <graphic>
                <Region styleClass="icon,ic-check,ic-dark" minWidth="18" minHeight="18" prefWidth="18" prefHeight="18" maxWidth="18" maxHeight="18"/>
              </graphic>
            </Button>
          </children>
        </HBox>
      </children>
    </VBox>
  </children>
</HBox>
