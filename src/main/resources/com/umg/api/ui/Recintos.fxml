<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<BorderPane prefWidth="1366" prefHeight="768" styleClass="app" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@styles.css" fx:controller="com.umg.api.ui.RecintosController">
  <center>
    <VBox>
      <children>
        <HBox alignment="BOTTOM_LEFT" spacing="10">
          <padding><Insets top="22" right="28" bottom="16" left="28"/></padding>
          <children>
            <VBox spacing="6">
              <children>
                <Label text="CATÁLOGO · PLANO DE CADA RECINTO" styleClass="eyebrow"/>
                <Label text="RECINTOS" styleClass="disp,s34"/>
              </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="BOTTOM_RIGHT" spacing="8">
              <children>
                <HBox alignment="CENTER_LEFT" styleClass="seg" spacing="2" maxWidth="-Infinity">
                  <children>
                    <Button text="Teatro" mnemonicParsing="false" styleClass="seg-btn,seg-on" prefHeight="34" id="btnPlano_teatro" fx:id="btnTeatro"/>
                    <Button text="Estadio" mnemonicParsing="false" styleClass="seg-btn" prefHeight="34" id="btnPlano_estadio" fx:id="btnEstadio"/>
                    <Button text="Explanada" mnemonicParsing="false" styleClass="seg-btn" prefHeight="34" id="btnPlano_explanada" fx:id="btnExplanada"/>
                  </children>
                </HBox>
                <HBox alignment="CENTER_RIGHT" spacing="10">
                  <children>
                    <Label text="" styleClass="s12,w500,c-dim" fx:id="lblAviso"/>
                    <Label text="Recinto" styleClass="s12,w600,c-muted"/>
                    <ComboBox styleClass="combo" prefWidth="260" prefHeight="34" fx:id="cmbRecinto"/>
                    <Button text="Nuevo recinto" styleClass="btn-ghost,btn-sm" mnemonicParsing="false" fx:id="btnNuevoRecinto"/>
                  </children>
                </HBox>
              </children>
            </VBox>
          </children>
        </HBox>
        <HBox alignment="TOP_LEFT" spacing="16" VBox.vgrow="ALWAYS">
          <padding><Insets top="0" right="28" bottom="24" left="28"/></padding>
          <children>
            <VBox prefWidth="340" minWidth="340" spacing="8">
              <children>
                <VBox fx:id="listaZonas" spacing="8">
                  <children>
                  </children>
                </VBox>
                <VBox styleClass="card" spacing="12" VBox.vgrow="ALWAYS">
                  <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                  <children>
                    <VBox spacing="6">
                      <children>
                        <Label text="Nombre" styleClass="form-lbl"/>
                        <TextField text="Platea" styleClass="input" prefHeight="40" id="txtNombreLocalidad" fx:id="txtNombre"/>
                      </children>
                    </VBox>
                    <Label text="Distribución: Bloques en abanico (A · B · C)" styleClass="s12,c-dim" fx:id="lblDistribucion"/>
                    <HBox alignment="CENTER_LEFT" spacing="8" fx:id="filaPorLado">
                      <children>
                        <Label text="Palcos por lado" styleClass="s13,w600" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="−" styleClass="btn-step,btn-step-sm" mnemonicParsing="false" graphicTextGap="8" fx:id="btnPorLadoMenos"/>
                        <HBox alignment="CENTER" minWidth="56"><children><Label text="4" styleClass="s14,w700" fx:id="lblPorLado"/><Label text=" / 5" styleClass="s14,w500,c-dim" fx:id="lblPorLadoMax"/></children></HBox>
                        <Button text="+" styleClass="btn-step,btn-step-sm" mnemonicParsing="false" graphicTextGap="8" fx:id="btnPorLadoMas"/>
                      </children>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8" fx:id="filaFilas">
                      <children>
                        <Label text="Filas por bloque" styleClass="s13,w600" HBox.hgrow="ALWAYS" maxWidth="Infinity" fx:id="lblFilasTitulo"/>
                        <Button text="−" styleClass="btn-step,btn-step-sm" mnemonicParsing="false" graphicTextGap="8" fx:id="btnFilasMenos"/>
                        <HBox alignment="CENTER" minWidth="56"><children><Label text="8" styleClass="s14,w700" fx:id="lblFilas"/><Label text=" / 10" styleClass="s14,w500,c-dim" fx:id="lblFilasMax"/></children></HBox>
                        <Button text="+" styleClass="btn-step,btn-step-sm" mnemonicParsing="false" graphicTextGap="8" fx:id="btnFilasMas"/>
                      </children>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8" fx:id="filaAsientos">
                      <children>
                        <Label text="Asientos por fila" styleClass="s13,w600" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="−" styleClass="btn-step,btn-step-sm" mnemonicParsing="false" graphicTextGap="8" fx:id="btnAsientosMenos"/>
                        <HBox alignment="CENTER" minWidth="56"><children><Label text="9" styleClass="s14,w700" fx:id="lblAsientos"/><Label text=" / 11" styleClass="s14,w500,c-dim" fx:id="lblAsientosMax"/></children></HBox>
                        <Button text="+" styleClass="btn-step,btn-step-sm" mnemonicParsing="false" graphicTextGap="8" fx:id="btnAsientosMas"/>
                      </children>
                    </HBox>
                    <VBox styleClass="note" fx:id="notaZona">
                      <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
                      <children>
                        <Label text="Zona sin asientos: el aforo y el precio se definen en cada concierto." styleClass="s12,c-text2" wrapText="true"/>
                      </children>
                    </VBox>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                      <children>
                        <Label text="Color" styleClass="s13,w600" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button styleClass="color-sw" mnemonicParsing="false" style="-fx-background-color: #FF5C8A;" fx:id="color1"/>
                        <Button styleClass="color-sw,color-on" mnemonicParsing="false" style="-fx-background-color: #3CC8E0;" fx:id="color2"/>
                        <Button styleClass="color-sw" mnemonicParsing="false" style="-fx-background-color: #A18CFF;" fx:id="color3"/>
                        <Button styleClass="color-sw" mnemonicParsing="false" style="-fx-background-color: #5BD68A;" fx:id="color4"/>
                        <Button styleClass="color-sw" mnemonicParsing="false" style="-fx-background-color: #6C9BFF;" fx:id="color5"/>
                        <Button styleClass="color-sw" mnemonicParsing="false" style="-fx-background-color: #E879F9;" fx:id="color6"/>
                      </children>
                    </HBox>
                    <Region VBox.vgrow="ALWAYS"/>
                    <HBox alignment="CENTER_LEFT" styleClass="editor-foot" spacing="8">
                      <padding><Insets top="10" right="0" bottom="0" left="0"/></padding>
                      <children>
                        <Label text="216 asientos" styleClass="s13,w700,c-amber" HBox.hgrow="ALWAYS" maxWidth="Infinity" fx:id="lblTotalNueva"/>
                        <Button text="Descartar" styleClass="btn-ghost,btn-sm" mnemonicParsing="false" graphicTextGap="8" fx:id="btnDescartar"/>
                        <Button text="Guardar" styleClass="btn-primary,btn-sm" mnemonicParsing="false" graphicTextGap="8" fx:id="btnGuardar"/>
                      </children>
                    </HBox>
                  </children>
                </VBox>
              </children>
            </VBox>
            <StackPane styleClass="map-area" HBox.hgrow="ALWAYS">
              <children>
                <VBox fx:id="planoPrevia" alignment="CENTER">
                  <padding><Insets top="16" right="16" bottom="40" left="16"/></padding>
                </VBox>
                <HBox StackPane.alignment="BOTTOM_LEFT" alignment="CENTER_LEFT" spacing="16" maxWidth="-Infinity" maxHeight="-Infinity" pickOnBounds="false" fx:id="leyenda">
                  <StackPane.margin><Insets left="16" bottom="14"/></StackPane.margin>
                  <children>
                    <HBox alignment="CENTER_LEFT" spacing="7"><children><Region styleClass="swatch" minWidth="12" minHeight="12" prefWidth="12" prefHeight="12" maxWidth="12" maxHeight="12" style="-fx-background-color: #3CC8E0;" fx:id="swConfigurado"/><Label text="Configurado · 216 asientos" styleClass="s12,w500,c-muted" fx:id="lblConfigurado"/></children></HBox>
                    <HBox alignment="CENTER_LEFT" spacing="7"><children><Region styleClass="swatch,seat-ghost" minWidth="12" minHeight="12" prefWidth="12" prefHeight="12" maxWidth="12" maxHeight="12" style="-fx-border-color: rgba(60,200,224,0.55);" fx:id="swMaximo"/><Label text="Máximo posible · 330 asientos" styleClass="s12,w500,c-muted" fx:id="lblMaximo"/></children></HBox>
                  </children>
                </HBox>
              </children>
            </StackPane>
          </children>
        </HBox>
      </children>
    </VBox>
  </center>
</BorderPane>
