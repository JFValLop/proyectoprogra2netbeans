<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="460" spacing="16" styleClass="dialog" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.umg.api.ui.RecuperarController">
   <padding>
      <Insets bottom="22" left="24" right="24" top="22" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT">
         <children>
            <Label styleClass="disp,s26" text="CAMBIAR CONTRASEÑA" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnCerrar" mnemonicParsing="false" styleClass="btn-icon">
               <graphic>
                  <Region maxHeight="18" maxWidth="18" minHeight="18" minWidth="18" prefHeight="18" prefWidth="18" styleClass="icon,ic-close,ic-muted" />
               </graphic>
            </Button>
         </children>
      </HBox>
      <Label styleClass="s13,c-muted" text="Te enviaremos un código de 6 números al correo registrado en tu usuario." wrapText="true" />
      <VBox spacing="6">
         <children>
            <Label styleClass="form-lbl" text="Usuario o correo" />
            <HBox alignment="CENTER_LEFT" spacing="8">
               <children>
                  <TextField fx:id="txtUsuario" prefHeight="42" promptText="p. ej. mcastillo o tu correo" styleClass="input" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnEnviar" mnemonicParsing="false" prefHeight="42" styleClass="btn-primary" text="Enviar código" />
               </children>
            </HBox>
         </children>
      </VBox>
      <Label fx:id="lblMensaje" styleClass="s12,c-dim" wrapText="true" />
      <VBox fx:id="pasoCodigo" managed="false" spacing="14" visible="false">
         <children>
            <VBox spacing="6">
               <children>
                  <Label styleClass="form-lbl" text="Código del correo" />
                  <TextField fx:id="txtCodigo" prefHeight="42" promptText="6 números" styleClass="input" />
               </children>
            </VBox>
            <HBox spacing="12">
               <children>
                  <VBox spacing="6" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="form-lbl" text="Contraseña nueva" />
                        <PasswordField fx:id="txtNueva" prefHeight="42" promptText="Mínimo 8 caracteres" styleClass="input" />
                     </children>
                  </VBox>
                  <VBox spacing="6" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="form-lbl" text="Confirmar contraseña" />
                        <PasswordField fx:id="txtConfirmar" prefHeight="42" styleClass="input" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
      <HBox alignment="CENTER_RIGHT" spacing="10">
         <children>
            <Button fx:id="btnCancelar" cancelButton="true" mnemonicParsing="false" styleClass="btn-ghost,btn-lg" text="Cancelar" />
            <Button fx:id="btnCambiar" disable="true" mnemonicParsing="false" styleClass="btn-primary,btn-lg" text="Cambiar contraseña" />
         </children>
      </HBox>
   </children>
</VBox>
