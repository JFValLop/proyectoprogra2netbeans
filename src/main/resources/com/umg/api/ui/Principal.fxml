<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<BorderPane prefWidth="1366" prefHeight="768" styleClass="app" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@styles.css" fx:controller="com.umg.api.ui.PrincipalController">
  <left>
    <VBox id="sidebar" styleClass="sidebar" prefWidth="216" minWidth="216" maxWidth="216" spacing="18">
      <padding><Insets top="16" right="12" bottom="12" left="12"/></padding>
      <children>
        <HBox alignment="CENTER_LEFT" spacing="10">
          <padding><Insets top="0" right="6" bottom="0" left="6"/></padding>
          <children>
            <ImageView fitWidth="36" fitHeight="36" preserveRatio="true" smooth="true">
              <image>
                <Image url="@logo.png"/>
              </image>
            </ImageView>
            <VBox spacing="3">
              <children>
                <Label text="Billets" styleClass="disp,s21"/>
                <Label text="TAQUILLA V1.0" styleClass="s10,w600,c-dim"/>
              </children>
            </VBox>
          </children>
        </HBox>
        <VBox spacing="2">
          <children>
            <Label text="OPERACIÓN" styleClass="eyebrow">
              <padding><Insets top="0" right="10" bottom="6" left="10"/></padding>
            </Label>
            <Button text="Panel de control" styleClass="nav-item" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT" graphicTextGap="10" prefHeight="38" fx:id="btnPanel">
              <graphic>
                <Region styleClass="icon,ic-dashboard,ic-text2" minWidth="20" minHeight="20" prefWidth="20" prefHeight="20" maxWidth="20" maxHeight="20"/>
              </graphic>
            </Button>
            <Button text="Punto de venta" styleClass="nav-item" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT" graphicTextGap="10" prefHeight="38" fx:id="btnPuntoVenta">
              <graphic>
                <Region styleClass="icon,ic-pos,ic-text2" minWidth="20" minHeight="20" prefWidth="20" prefHeight="20" maxWidth="20" maxHeight="20"/>
              </graphic>
            </Button>
            <Button text="Validar boletos" styleClass="nav-item" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT" graphicTextGap="10" prefHeight="38" fx:id="btnValidar">
              <graphic>
                <Region styleClass="icon,ic-ticket,ic-text2" minWidth="20" minHeight="20" prefWidth="20" prefHeight="20" maxWidth="20" maxHeight="20"/>
              </graphic>
            </Button>
            <Button text="Historial de ventas" styleClass="nav-item" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT" graphicTextGap="10" prefHeight="38" fx:id="btnHistorial">
              <graphic>
                <Region styleClass="icon,ic-list,ic-text2" minWidth="20" minHeight="20" prefWidth="20" prefHeight="20" maxWidth="20" maxHeight="20"/>
              </graphic>
            </Button>
            <Button text="Clientes" styleClass="nav-item" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT" graphicTextGap="10" prefHeight="38" fx:id="btnClientes">
              <graphic>
                <Region styleClass="icon,ic-person,ic-text2" minWidth="20" minHeight="20" prefWidth="20" prefHeight="20" maxWidth="20" maxHeight="20"/>
              </graphic>
            </Button>
            <Button text="Reportes" styleClass="nav-item" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT" graphicTextGap="10" prefHeight="38" fx:id="btnReportes">
              <graphic>
                <Region styleClass="icon,ic-chart,ic-text2" minWidth="20" minHeight="20" prefWidth="20" prefHeight="20" maxWidth="20" maxHeight="20"/>
              </graphic>
            </Button>
          </children>
        </VBox>
        <VBox spacing="2" fx:id="grupoCatalogos">
          <children>
            <Label text="CATÁLOGOS" styleClass="eyebrow">
              <padding><Insets top="0" right="10" bottom="6" left="10"/></padding>
            </Label>
            <Button text="Artistas" styleClass="nav-item" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT" graphicTextGap="10" prefHeight="38" fx:id="btnArtistas">
              <graphic>
                <Region styleClass="icon,ic-mic,ic-text2" minWidth="20" minHeight="20" prefWidth="20" prefHeight="20" maxWidth="20" maxHeight="20"/>
              </graphic>
            </Button>
            <Button text="Conciertos" styleClass="nav-item" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT" graphicTextGap="10" prefHeight="38" fx:id="btnConciertos">
              <graphic>
                <Region styleClass="icon,ic-event,ic-text2" minWidth="20" minHeight="20" prefWidth="20" prefHeight="20" maxWidth="20" maxHeight="20"/>
              </graphic>
            </Button>
            <Button text="Recintos" styleClass="nav-item" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT" graphicTextGap="10" prefHeight="38" fx:id="btnLocalidades">
              <graphic>
                <Region styleClass="icon,ic-seat,ic-amber" minWidth="20" minHeight="20" prefWidth="20" prefHeight="20" maxWidth="20" maxHeight="20"/>
              </graphic>
            </Button>
            <Button text="Usuarios" styleClass="nav-item" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT" graphicTextGap="10" prefHeight="38" fx:id="btnUsuarios">
              <graphic>
                <Region styleClass="icon,ic-group,ic-text2" minWidth="20" minHeight="20" prefWidth="20" prefHeight="20" maxWidth="20" maxHeight="20"/>
              </graphic>
            </Button>
          </children>
        </VBox>
        <Region VBox.vgrow="ALWAYS"/>
        <VBox styleClass="turno-card" spacing="4">
          <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
          <children>
            <Label text="HOY · TODAS" styleClass="eyebrow" fx:id="lblTurnoTitulo"/>
            <Label text="Q 48,350" styleClass="disp,s24" fx:id="lblTurnoTotal"/>
            <Label text="16 ventas · 41 boletos" styleClass="s12,c-muted" fx:id="lblTurnoDetalle"/>
          </children>
        </VBox>
        <HBox alignment="CENTER_LEFT" spacing="10">
          <padding><Insets top="4" right="4" bottom="0" left="4"/></padding>
          <children>
            <StackPane styleClass="avatar" minWidth="34" minHeight="34" prefWidth="34" prefHeight="34" maxWidth="34" maxHeight="34">
              <children>
                <Label text="AM" styleClass="s12,w700,c-amber" fx:id="lblIniciales"/>
              </children>
            </StackPane>
            <VBox HBox.hgrow="ALWAYS">
              <children>
                <Label text="Andrea Morales" styleClass="s13,w600" fx:id="lblNombre"/>
                <Label text="Administrador" styleClass="s11,c-dim" fx:id="lblRol"/>
              </children>
            </VBox>
            <Button styleClass="btn-icon" mnemonicParsing="false" graphicTextGap="8" id="btnCerrarSesion" fx:id="btnCerrarSesion">
              <graphic>
                <Region styleClass="icon,ic-logout,ic-muted" minWidth="18" minHeight="18" prefWidth="18" prefHeight="18" maxWidth="18" maxHeight="18"/>
              </graphic>
            </Button>
          </children>
        </HBox>
      </children>
    </VBox>
  </left>
  <center>
    <StackPane>
      <children>
        <StackPane fx:id="contenido"/>
        <VBox fx:id="avisos" StackPane.alignment="BOTTOM_RIGHT" alignment="BOTTOM_RIGHT" spacing="8" maxWidth="-Infinity" maxHeight="-Infinity" mouseTransparent="true">
          <StackPane.margin><Insets right="20" bottom="20"/></StackPane.margin>
        </VBox>
      </children>
    </StackPane>
  </center>
</BorderPane>
