<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="480" spacing="16" styleClass="dialog" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.umg.api.ui.RecintoFormController">
   <padding>
      <Insets bottom="22" left="24" right="24" top="22" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT">
         <children>
            <VBox spacing="2">
               <children>
                  <Label fx:id="lblTitulo" styleClass="disp,s26" text="NUEVO RECINTO" />
                  <Label fx:id="lblTipo" styleClass="s12,c-dim" text="Plano tipo Teatro" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnCerrar" mnemonicParsing="false" styleClass="btn-icon">
               <graphic>
                  <Region maxHeight="18" maxWidth="18" minHeight="18" minWidth="18" prefHeight="18" prefWidth="18" styleClass="icon,ic-close,ic-muted" />
               </graphic>
            </Button>
         </children>
      </HBox>
      <VBox spacing="6">
         <children>
            <Label styleClass="form-lbl" text="Nombre del recinto" />
            <TextField fx:id="txtNombre" prefHeight="42" promptText="p. ej. Teatro Nacional" styleClass="input" />
         </children>
      </VBox>
      <VBox spacing="6">
         <children>
            <Label styleClass="form-lbl" text="País" />
            <ComboBox fx:id="cmbPais" maxWidth="Infinity" prefHeight="42" promptText="Elige el país" styleClass="combo" />
         </children>
      </VBox>
      <VBox spacing="6">
         <children>
            <Label styleClass="form-lbl" text="Ciudad" />
            <TextField fx:id="txtCiudad" prefHeight="42" promptText="p. ej. Antigua Guatemala" styleClass="input" />
         </children>
      </VBox>
      <VBox spacing="6">
         <children>
            <Label styleClass="form-lbl" text="Dirección" />
            <TextField fx:id="txtDireccion" prefHeight="42" promptText="p. ej. 5a Avenida Norte #12, zona 1" styleClass="input" />
         </children>
      </VBox>
      <Label fx:id="lblMensaje" styleClass="s12,c-red" wrapText="true" />
      <HBox alignment="CENTER_RIGHT" spacing="12">
         <children>
            <Button fx:id="btnCancelar" mnemonicParsing="false" prefHeight="44" styleClass="btn-ghost" text="Cancelar" />
            <Button fx:id="btnGuardar" mnemonicParsing="false" prefHeight="44" styleClass="btn-primary" text="Guardar recinto" />
         </children>
      </HBox>
   </children>
</VBox>
